{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "web-porcicola-produccion",
  "account_id": "0acfa25b5f619f94d581b8cf882e2eec",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-07-01",
  "triggers": {
    "crons": ["5 5 * * *"]
  },
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "webporcicola-produccion",
      "database_id": "1a6f4451-bde8-46cf-beae-ed4dd76d34c0"
    }
  ],
  "env": {
    "production": {
      "name": "web-porcicola-produccion",
      "triggers": {
        "crons": ["5 5 * * *"]
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "webporcicola-produccion",
          "database_id": "1a6f4451-bde8-46cf-beae-ed4dd76d34c0"
        }
      ]
    }
  }
}
